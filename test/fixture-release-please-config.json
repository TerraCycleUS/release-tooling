{
  "pull-request-title-pattern": "chore${scope}: prepare${component} ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "maintenance",
      "section": "Maintenance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores"
    },
    {
      "type": "spike",
      "section": "Spikes"
    }
  ]
}
